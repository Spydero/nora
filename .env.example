# Local infrastructure (docker-compose.yml). Copy to .env to override defaults.
POSTGRES_USER=nora
POSTGRES_PASSWORD=nora_dev_password
POSTGRES_DB=nora
POSTGRES_PORT=5433
REDIS_PASSWORD=nora_dev_redis
REDIS_PORT=6379

# AI (OpenRouter first, Gemini as fallback). Read by the API and passed into the api container.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
