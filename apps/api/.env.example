NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://nora:nora_dev_password@localhost:5433/nora?schema=public
REDIS_URL=redis://:nora_dev_redis@localhost:6379

# Origin of the web app; used for CORS and CSRF origin checks.
WEB_ORIGIN=http://localhost:3000

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=nora-api
JWT_AUDIENCE=nora-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PATIENT_IDLE_TIMEOUT_MINUTES=30
STAFF_IDLE_TIMEOUT_MINUTES=15

# Set to true behind HTTPS.
COOKIE_SECURE=false

# AI via OpenRouter (https://openrouter.ai/keys). The key is read from the repo-root .env
# (or set OPENROUTER_API_KEY here). Without a key Nora runs in labelled template mode.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FAST_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_DECISION_MODEL=inception/mercury-decide:free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
AI_TIMEOUT_MS=45000
AI_MAX_RESEARCH_ROUNDS=3
